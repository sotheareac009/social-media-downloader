# ---------------------------------------------------------------------------
# Media Downloader - application OAuth configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is not, so
# never put a real value in this file.
#
# What belongs here: the client ID / client secret / redirect URI that a
# platform issued to THIS APPLICATION.
#
# What must never go here: a user's access token or refresh token. Those are
# written to the OS keychain by the app and never touch a file.
#
# A real shell environment variable always overrides the value below.
# ---------------------------------------------------------------------------


# --- Google ----------------------------------------------------------------
# Google Cloud Console -> Credentials -> Create OAuth client ID -> Desktop app
#
# No redirect URI needs registering: Google accepts any http://127.0.0.1:{port}
# loopback for Desktop clients, which is what this app binds per flow.
GOOGLE_CLIENT_ID=

# Optional. Desktop clients are public clients - RFC 8252 section 8.5 - so this
# is not a real secret and PKCE is what secures the flow. Set it only if your
# client configuration requires it at the token endpoint.
GOOGLE_CLIENT_SECRET=


# --- Facebook --------------------------------------------------------------
# All THREE are required; the provider stays disabled until every one is set.
#
# Facebook has no native/desktop client type, which is why it needs more than
# Google does:
#
#   * FACEBOOK_REDIRECT_URI cannot be a 127.0.0.1 loopback - Facebook rejects
#     those. It must be an https URL whose host you have added under
#     App Dashboard -> Facebook Login -> Settings -> Valid OAuth Redirect URIs.
#     In practice that means hosting a small redirect page you control.
#
#   * FACEBOOK_CLIENT_SECRET is genuinely confidential to Facebook, but it
#     cannot stay confidential inside a desktop binary. Setting it is an
#     explicit acceptance of that trade-off.
#
# Scope requested is public_profile only. Facebook login grants NO access to
# private media, and an OAuth token is not a browser cookie.
#
# App Dashboard: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=


# --- Instagram -------------------------------------------------------------
# "Instagram API with Instagram Login" (Business Login). All THREE required.
#
# Requires an Instagram BUSINESS or CREATOR account - this API replaced the
# Basic Display API, which Meta shut down in December 2024. A personal account
# cannot complete this flow.
#
#   * INSTAGRAM_REDIRECT_URI must be registered under
#     App Dashboard -> Instagram -> API setup -> Business login settings.
#     Loopback 127.0.0.1 is not accepted.
#
#   * INSTAGRAM_CLIENT_SECRET is required both for the code exchange and for
#     the mandatory long-lived token exchange that follows it.
#
# Scope requested is instagram_business_basic only. Login authenticates an
# identity; it grants NO access to private or downloadable media.
#
# App Dashboard: https://developers.facebook.com/apps/
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=


# --- TikTok ----------------------------------------------------------------
# Only TWO values are needed. TikTok's "Login Kit for Desktop" product uses a
# LOOPBACK redirect, so there is no redirect URI to put here - the app binds an
# ephemeral port per flow, exactly like Google.
#
# One-time setup in the TikTok developer portal:
#   1. Add the "Login Kit" product to your app.
#   2. Under Login Kit -> Redirect URI, register EXACTLY:
#
#          http://127.0.0.1:*/callback
#
#      The wildcard port is required: the app uses a fresh ephemeral port each
#      time. TikTok permits ONLY localhost / 127.0.0.1 hosts for desktop, a
#      port is mandatory, and no query string or fragment may be appended.
#
# PKCE is mandatory for TikTok desktop; the app always sends it.
#
# Developer portal: https://developers.tiktok.com/apps/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=


# --- Advanced --------------------------------------------------------------
# Load a .env from an explicit path instead of the discovered one. Must be set
# as a real environment variable, since it decides which file gets read.
# MEDIA_DOWNLOADER_ENV_FILE=/absolute/path/to/.env
