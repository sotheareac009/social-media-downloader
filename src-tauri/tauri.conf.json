{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SocialSync",
  "version": "0.0.4",
  "identifier": "com.reach.mediadownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SocialSync",
        "width": 1160,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; media-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' asset: http://asset.localhost wss://*.web.telegram.org:443 wss://*.web.telegram.org https://*.web.telegram.org",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sotheareac009/social-media-downloader/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFOTMxRDFDMEMxMUZEQjUKUldTMS9SRU1IQjJUbm82U1RmUHBjRU96dzBHM1VmbU9Cb0ZHYjdwcmxlQzdWUS91TFlLSzdEbUsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
